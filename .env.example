# Copy to .env for local (non-Docker) development.
# docker-compose.yml sets these itself and does not read this file.

# --- database ---------------------------------------------------------------
POSTGRES_USER=catalyst
POSTGRES_PASSWORD=catalyst
POSTGRES_DB=catalyst

# Host port the compose Postgres is published on. 5432 is left alone because it
# is so often already taken; change this if 5433 clashes too. Services inside
# the compose network are unaffected — they reach Postgres on 5432 by name.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://catalyst:catalyst@localhost:5433/catalyst

# --- jobs -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- api --------------------------------------------------------------------
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Providers available to the run pipeline. Until Phase 6 ships real predictors the
# only implementation is MockProvider, which forces demo mode on across the product:
# a persistent amber bar, a badge on every number it produced, watermarked exports,
# and a refusal to generate primers.
CATALYST_PROVIDERS=mock

# --- web --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
